/* =========================================================
   01. GLOBAL BASE STYLES
   ========================================================= */

QWidget {
    font-family: "Segoe UI";
    font-size: 14px;
    color: #E7E6F6;
}

QLabel {
    background: transparent;
}

#appRoot {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #081222,
        stop: 0.4 #0B1F3A,
        stop: 1 #122949
    );
}


/* =========================================================
   02. GLOBAL INPUT FIELDS
   ========================================================= */

QLineEdit {
    background: rgba(11, 31, 58, 0.54);
    color: #F5F7FF;
    border: 1px solid rgba(134, 168, 207, 0.26);
    border-radius: 14px;
    padding: 8px 14px;
    selection-background-color: #C38EB4;
}

QLineEdit:focus {
    border: 1px solid rgba(195, 142, 180, 0.72);
}

QLineEdit#sidebarSearch,
QLineEdit#messageInput {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.10);
    color: #F5F7FF;
}

QLineEdit#sidebarSearch {
    padding: 2px 12px;
    min-height: 26px;
    max-height: 30px;
    border-radius: 11px;
    font-size: 14px;
}


/* =========================================================
   03. GLOBAL BUTTONS
   ========================================================= */

QPushButton {
    background: rgba(255, 255, 255, 0.08);
    color: #F4F6FF;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 700;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 0.14);
}

QPushButton:checked {
    background: rgba(195, 142, 180, 0.24);
    border: 1px solid rgba(195, 142, 180, 0.48);
}

QPushButton#primaryButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #86A8CF,
        stop: 1 #C38EB4
    );
    color: #FFFFFF;
    border: none;
    font-weight: 800;
    font-size: 18px;
    border-radius: 12px;
}
QPushButton#primaryButton:hover {
    background: #A5C0DD;
}

QPushButton#dangerButton {
    background: rgba(195, 142, 180, 0.20);
    color: #FFFFFF;
    border: 1px solid rgba(195, 142, 180, 0.45);
    border-radius: 10px;
    padding: 0;
    font-size: 12px;
    font-weight: 800;
}

QPushButton#dangerButton:hover {
    background: rgba(195, 142, 180, 0.32);
}

QPushButton#filterButton {
    background: rgba(255,255,255,0.10);
    color: rgba(255,255,255,0.86);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 12px;
    padding: 6px 10px;
    font-weight: 800;
    min-height: 30px;
    max-height: 42px;
}

QPushButton#filterButton:hover {
    background: rgba(255,255,255,0.16);
    color: #FFFFFF;
}

QPushButton#filterButton:checked {
    background: rgba(195,142,180,0.32);
    color: #FFFFFF;
    border: 1px solid rgba(195,142,180,0.65);
}

QToolButton#ghostToolButton,
QPushButton#ghostToolButton {
    background: rgba(255,255,255,0.10);
    color: #EAF1FF;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 9px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 700;
}

QToolButton#ghostToolButton:hover,
QPushButton#ghostToolButton:hover {
    background: rgba(134,168,207,0.24);
    border: 1px solid rgba(134,168,207,0.45);
    color: #FFFFFF;
}

QToolButton#ghostToolButton:pressed,
QPushButton#ghostToolButton:pressed {
    background: rgba(195,142,180,0.32);
}

QToolButton#roundToolButton {
    background: rgba(255,255,255,0.08);
    color: #E8EAFA;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 26px;
    min-width: 52px;
    min-height: 52px;
    max-width: 52px;
    max-height: 52px;
    font-size: 24px;
}

QToolButton#roundToolButton:hover {
    background: rgba(255,255,255,0.14);
}

QPushButton#emojiButton {
    background: rgba(255,255,255,0.08);
    border-radius: 9px;
    border: 1px solid rgba(255,255,255,0.08);
    padding: 0;
    font-size: 18px;
}


QToolButton#sidebarToggleButton {
    background: rgba(255, 255, 255, 0.10);
    color: #EAF1FF;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    font-size: 18px;
    font-weight: 800;
}

QToolButton#sidebarToggleButton:hover {
    background: rgba(134, 168, 207, 0.24);
    border: 1px solid rgba(134, 168, 207, 0.45);
    color: #FFFFFF;
}

QToolButton#sidebarToggleButton {
    background: rgba(255,255,255,0.10);
    color: #EAF1FF;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 10px;
    font-size: 20px;
    font-weight: 800;
}

QToolButton#sidebarToggleButton:hover {
    background: rgba(134,168,207,0.24);
    border: 1px solid rgba(134,168,207,0.45);
}

/* =========================================================
   04. SPLASH SCREEN
   ========================================================= */

QFrame#splashCard {
    background: rgba(15, 26, 46, 0.74);
    border: 1px solid rgba(225, 203, 215, 0.18);
    border-radius: 24px;
}

QLabel#splashTitle {
    color: white;
    font-size: 40px;
    font-weight: 800;
}

QLabel#splashSubtitle {
    color: #C8D4E6;
    font-size: 16px;
}

QLabel#splashFooter {
    color: #9DB3D1;
    font-size: 13px;
    font-weight: 600;
}


/* =========================================================
   05. LOGIN WINDOW
   ========================================================= */

QFrame#loginShell {
    background: rgba(10, 20, 37, 0.56);
    border: 1px solid rgba(225, 203, 215, 0.12);
    border-radius: 28px;
}

QFrame#loginHero {
    border-top-left-radius: 28px;
    border-bottom-left-radius: 28px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0B1F3A,
        stop: 0.4 #26425A,
        stop: 0.75 #5E3B82,
        stop: 1 #8A3D74
    );
}

QFrame#loginFormPanel {
    background: rgba(8, 18, 34, 0.72);
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
}

QLabel#loginBadge {
    color: rgba(255,255,255,0.86);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#loginHeroTitle {
    color: white;
    font-size: 38px;
    font-weight: 750;
    line-height: 1.12;
}

QLabel#loginHeroText,
QLabel#featurePillText {
    color: #E6EAF7;
    font-size: 15px;
    line-height: 1.45;
}

QFrame#featureGlassCard,
QFrame#loginCard,
QFrame#tinyFeatureGrid {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(225, 203, 215, 0.12);
    border-radius: 18px;
}

QLabel#loginBrandText {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 800;
}

QLabel#loginHeading {
    color: white;
    font-size: 40px;
    font-weight: 800;
}

QLabel#loginSubheading,
QLabel#helperText,
QLabel#loginFooter,
QLabel#tinyFeatureText {
    color: #BFCBE2;
    font-size: 14px;
}

QLabel#formLabel {
    color: #E8ECF7;
    font-size: 14px;
    font-weight: 700;
}

QLabel#formError {
    color: #FFB4C8;
    font-size: 13px;
    font-weight: 700;
}


/* =========================================================
   06. MAIN CHAT LAYOUT
   ========================================================= */

QFrame#sidebarPanel,
QFrame#mainPanel {
    border-radius: 26px;
    border: 1px solid rgba(225, 203, 215, 0.10);
}

QFrame#sidebarPanel {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #132544,
        stop: 0.45 #18315A,
        stop: 1 #10203A
    );
}

QFrame#mainPanel {
    background: rgba(8, 18, 34, 0.56);
}


/* =========================================================
   07. SIDEBAR BRANDING
   ========================================================= */

QLabel#sidebarBrandSubtitle {
    color: #B8C7DE;
    font-size: 15px;
    margin-top: 0px;
    padding-top: 0px;
    font-weight: 500;
}

QLabel#sidebarSectionTitle {
    color: #F4F6FF;
    font-size: 16px;
    font-weight: 700;
}


/* =========================================================
   08. SIDEBAR LISTS
   ========================================================= */

QListWidget#sidebarList {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    padding: 8px;
    outline: none;
}

QListWidget#sidebarList::item {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px 14px;
    border-radius: 12px;
}

QListWidget#sidebarList::item:selected {
    background: rgba(134, 168, 207, 0.18);
    border-radius: 12px;
}

QListWidget#sidebarList::item:hover {
    background: rgba(134, 168, 207, 0.10);
    border-radius: 12px;
}

QFrame#sidebarAvatar,
QFrame#sidebarAvatarAccent {
    border-radius: 21px;
}

QFrame#sidebarAvatar {
    background: rgba(255,255,255,0.10);
}

QFrame#sidebarAvatarAccent {
    background: rgba(134, 168, 207, 0.26);
    border: 1px solid rgba(225, 203, 215, 0.14);
}

QLabel#sidebarAvatarText {
    color: #F8FBFF;
    font-size: 16px;
    font-weight: 800;
}

QLabel#sidebarItemTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
}

QLabel#sidebarItemSubtitle,
QLabel#sidebarItemTrailing {
    color: #B8C7DE;
}

QLabel#sidebarOnlineDot {
    color: #9CFAB2;
    font-size: 11px;
}


/* =========================================================
   09. BOTTOM USER CARD
   ========================================================= */

QFrame#sidebarUserCard {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 19px;
}

QLabel#bottomAvatar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #86A8CF,
        stop: 1 #C38EB4
    );
    color: #081222;
    font-size: 20px;
    font-weight: 800;
    border-radius: 26px;
    min-width: 52px;
    min-height: 52px;
    max-width: 52px;
    max-height: 52px;
}

QLabel#bottomUserName {
    color: #FFFFFF;
    font-weight: 800;
}

QLabel#bottomUserStatus {
    color: #B8C7DE;
}


/* =========================================================
   10. CHAT HEADER
   ========================================================= */

QFrame#chatHeader {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 19px;
}

QLabel#targetBadge {
    color: #AFC8E8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#chatTitle {
    color: #FFFFFF;
    font-size: 28px;
    font-weight: 800;
}

QLabel#chatSubtitle {
    color: #B8C7DE;
    font-size: 14px;
}

QLabel#statusBadge {
    background: rgba(156, 250, 178, 0.12);
    border: 1px solid rgba(156, 250, 178, 0.18);
    color: #A8F2BA;
    border-radius: 12px;
    padding: 0;
    font-size: 12px;
    font-weight: 800;
}


/* =========================================================
   11. MESSAGE AREA / SURFACE
   ========================================================= */

QWidget#messagesSurface {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 19px;
}

QScrollArea#messagesScroll {
    background: transparent;
    border: none;
}

QLabel#systemNotice {
    color: #9DB3D1;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 0;
}


/* =========================================================
   12. COMPOSER / MESSAGE INPUT AREA
   ========================================================= */

QFrame#composerPanel {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 19px;
}

QLabel#contextMetaLabel,
QLabel#contextLabel,
QLabel#typingLabel {
    color: #B8C7DE;
}

QLabel#replyChip,
QLabel#replyBarText {
    color: #D9E0EF;
    font-size: 12px;
}

QFrame#replyBar {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 19px;
}


/* =========================================================
   13. MESSAGE BUBBLES
   ========================================================= */

QFrame#messageBubbleOwn {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #86A8CF,
        stop:1 #C38EB4
    );
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.12);
}

QFrame#messageBubbleOther {
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 16px;
}

QLabel#messageSenderOwn {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 800;
}

QLabel#messageSenderOther {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 800;
}

QLabel#messageText {
    color: #FFFFFF;
    font-size: 14px;
}

QLabel#messageMeta,
QLabel#messageStatus {
    color: rgba(255,255,255,0.70);
    font-size: 11px;
    font-weight: 600;
}


/* =========================================================
   14. REPLY PREVIEW INSIDE MESSAGE BUBBLES
   ========================================================= */

QFrame#replyPreviewBox {
    background: rgba(255,255,255,0.12);
    border-left: 3px solid #C38EB4;
    border-radius: 9px;
}

QLabel#replySenderLabel {
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
}

QLabel#replyTextLabel {
    color: rgba(255,255,255,0.78);
    font-size: 12px;
}

QLabel#replyHoverIcon {
    background-color: rgba(255,255,255,0.08);
    color: #C38EB4;
    border-radius: 11px;
    font-size: 14px;
    font-weight: bold;
}

QLabel#replyHoverIcon:hover {
    background-color: rgba(195,142,180,0.25);
    color: #ffffff;
}

/* =========================================================
   15. OLD / FALLBACK BUBBLE STYLES
   Keep only if older widgets still use these IDs.
   ========================================================= */

QFrame#ownBubble {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #4E6F9A,
        stop: 1 #8D5F89
    );
    border-radius: 16px;
}

QFrame#incomingBubble {
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
}

QLabel#bubbleSender {
    color: #E1CBD7;
    font-size: 12px;
    font-weight: 700;
}

QLabel#bubbleText {
    color: #F7F8FE;
    font-size: 14px;
    line-height: 1.5;
}

QLabel#bubbleMeta {
    color: #9FB2CF;
    font-size: 11px;
}


/* =========================================================
   16. INFO CARDS / DIALOG TITLES
   ========================================================= */

QLabel#infoCardValue,
QLabel#dialogTitle {
    color: #FFFFFF;
    font-weight: 800;
}


/* =========================================================
   17. DIALOGS AND EMOJI PICKER
   ========================================================= */

QDialog#profileDialog,
QDialog#roomDialog,
QWidget#emojiPicker {
    background: rgba(11, 31, 58, 0.96);
    border: 1px solid rgba(225, 203, 215, 0.10);
    border-radius: 16px;
}


/* =========================================================
   18. CONTEXT MENU
   ========================================================= */

QMenu {
    background: #111D33;
    color: #EAF1FF;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 9px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 20px;
    border-radius: 7px;
}

QMenu::item:selected {
    background: rgba(134,168,207,0.28);
}


/* =========================================================
   19. SCROLLBARS
   ========================================================= */

QScrollBar:vertical {
    width: 7px;
    background: transparent;
    margin: 4px 0 4px 0;
}

QScrollBar::handle:vertical {
    background: rgba(134, 168, 207, 0.34);
    min-height: 20px;
    border-radius: 4px;
}


/* =========================================================
   20. MESSAGE BOXES
   ========================================================= */

QMessageBox {
    background-color: #1E2A3A;
    color: #EAF1FF;
    border-radius: 10px;
}

QMessageBox QLabel {
    color: #EAF1FF;
    font-size: 14px;
}

QMessageBox QPushButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #86A8CF,
        stop:1 #C38EB4
    );
    color: white;
    border: none;
    border-radius: 7px;
    padding: 6px 16px;
    font-weight: 600;
}

QMessageBox QPushButton:hover {
    opacity: 0.85;
}

QMessageBox QPushButton:pressed {
    opacity: 0.7;
}

QListWidget#sidebarList QScrollBar:horizontal {
    height: 0px;
    background: transparent;
}

QListWidget#sidebarList {
    padding-right: 0px;
}