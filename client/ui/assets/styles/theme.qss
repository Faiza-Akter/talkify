QWidget#messagesSurface {
    background: rgba(255,255,255,0.045);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
}

QFrame#emptyStateCard {
    background: transparent;
    border: none;
    min-width: 0px;
    max-width: 420px;
}

QLabel#emptyStateIcon {
    font-size: 28px;
    color: rgba(225,203,215,0.72);
}

QLabel#emptyStateTitle {
    color: rgba(255,255,255,0.88);
    font-size: 16px;
    font-weight: 800;
}

QLabel#emptyStateSubtitle {
    color: rgba(184,199,222,0.80);
    font-size: 12px;
}

QFrame#composerPanel {
    background: rgba(255,255,255,0.055);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 16px;
    min-height: 64px;
    max-height: 118px;
}

QLabel#typingLabel {
    color: transparent;
    min-height: 0px;
    max-height: 0px;
    padding: 0px;
    margin: 0px;
}

QFrame#messageInputShell {
    background: rgba(255,255,255,0.075);
    border: 1px solid rgba(255,255,255,0.13);
    border-radius: 14px;
    min-height: 42px;
    max-height: 46px;
}

QLineEdit#messageInput {
    background: transparent;
    border: none;
    padding: 0px 4px;
    min-height: 38px;
    max-height: 42px;
    font-size: 15px;
}

QToolButton#emojiInsideButton {
    background: transparent;
    border: none;
    color: #EAF1FF;
    font-size: 18px;
    border-radius: 0px;
    padding: 0px;
}

QToolButton#emojiInsideButton:hover {
    background: transparent;
    border: none;
    color: #FFD6EA;
}

QPushButton#primaryButton {
    border-radius: 14px;
    font-size: 18px;
    padding: 0px 14px;
    min-height: 42px;
}

QFrame#inlineReplyFrame {
    background: rgba(195,142,180,0.13);
    border: 1px solid rgba(195,142,180,0.22);
    border-radius: 12px;
}

QFrame#inlineReplyAccent,
QFrame#replyPreviewBox {
    border-left-color: #F2A7CF;
}

QFrame#inlineReplyAccent {
    background: #F2A7CF;
    border-radius: 2px;
}

QLabel#inlineReplySender,
QLabel#replySenderLabel {
    color: #FFD6EA;
    font-weight: 900;
}

QFrame#messageBubbleOwn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5878A8, stop:0.50 #7566A5, stop:1 #965384);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 13px;
}

QFrame#messageBubbleOther {
    background: rgba(255,255,255,0.13);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 13px;
}

QLabel#messageText,
QLabel#messageSenderOwn,
QLabel#messageSenderOther,
QLabel#messageMeta,
QLabel#messageStatus {
    color: #FFFFFF;
}

QLabel#messageMeta,
QLabel#messageStatus {
    font-size: 10px;
}

QLabel#messageReactions {
    background: #081222;
    color: #FFFFFF;
    padding: 0px;
    font-size: 12px;
    font-weight: 900;
    min-height: 24px;
}

QFrame#replyPreviewBox {
    border-left: 3px solid #F2A7CF;
    background: rgba(195,142,180,0.14);
    border-radius: 8px;
}

QFrame#messageActionsRail {
    background: transparent;
    border: none;
}

QToolButton#messageActionButton {
    background: rgba(12, 22, 39, 0.92);
    color: #EAF1FF;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 10px;
    font-size: 14px;
}

QToolButton#messageActionButton:hover {
    background: rgba(195,142,180,0.30);
    border: 1px solid rgba(195,142,180,0.45);
    color: #FFFFFF;
}

/* =========================================================
   PROFILE DIALOG PROFESSIONAL REDESIGN
   ========================================================= */

QDialog#profileDialog {
    background: #10233F;
    border: 1px solid rgba(225,203,215,0.18);
    border-radius: 18px;
}

QDialog#profileDialog QFrame#dialogHeroCard {
    background: rgba(255,255,255,0.055);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 18px;
}

QDialog#profileDialog QFrame#dialogGlassCard {
    background: rgba(255,255,255,0.045);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 18px;
}

QDialog#profileDialog QLabel#dialogTitle {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 900;
}

QDialog#profileDialog QLabel#dialogHint {
    color: #BFD1EA;
    font-size: 13px;
}

QDialog#profileDialog QLabel#fieldLabel {
    color: #E7B8D9;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.2px;
}

QDialog#profileDialog QLabel#profilePreviewAvatar {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #86A8CF,
        stop:1 #C38EB4
    );
    color: #081222;
    border-radius: 35px;
    font-size: 28px;
    font-weight: 900;
}

QDialog#profileDialog QLineEdit#profileInput {
    background: rgba(8,18,34,0.42);
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 13px;
    padding: 0px 14px;
    font-size: 14px;
}

QDialog#profileDialog QLineEdit#profileInput:focus {
    border: 1px solid rgba(195,142,180,0.75);
    background: rgba(8,18,34,0.58);
}

QDialog#profileDialog QPushButton#ghostToolButton {
    background: rgba(255,255,255,0.075);
    color: #EAF1FF;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 12px;
    font-weight: 800;
}

QDialog#profileDialog QPushButton#ghostToolButton:hover {
    background: rgba(195,142,180,0.22);
    border: 1px solid rgba(195,142,180,0.38);
}

QDialog#profileDialog QPushButton#primaryButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #86A8CF,
        stop:1 #C38EB4
    );
    color: white;
    border: none;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 900;
}

QDialog#profileDialog QPushButton#primaryButton:hover {
    background: #A5C0DD;
}

#adminStatText {
    color: #EAF1FF;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

#adminBannedUserText {
    color: #EAF1FF;
    font-size: 14px;
    background: transparent;
}

